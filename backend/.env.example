# Configurações do Banco de Dados (Supabase ou PostgreSQL local)
# Quem for rodar o projeto deve copiar este arquivo para .env e preencher com seus dados
# O .env é ignorado pelo git: nunca commite senha de banco ou chave do JWT.
# Sem o .env o backend sobe com banco em memória (H2): serve para testar, mas os dados somem ao parar.
# No Supabase: Connect > Session pooler. O usuário tem o formato postgres.xxxxx
DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.xxxxx
DB_PASSWORD=sua_senha_secreta_aqui

# Configurações de Segurança JWT (a chave precisa ter pelo menos 32 caracteres)
# Troque pelo resultado de: openssl rand -hex 32
# Em produção o back se recusa a subir com o valor de exemplo abaixo.
JWT_SECRET=sua_chave_secreta_muito_longa_e_segura_aqui_com_pelo_menos_256_bits
JWT_EXPIRATION=86400000

# Endereços do front que podem chamar a API (separados por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Opcional: servidor de e-mail (SMTP) para os avisos. Sem MAIL_HOST, os avisos só aparecem no log.
# Gmail: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME=seu e-mail, MAIL_PASSWORD=uma "senha de app"
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Opcional: token do GitHub (sem permissão nenhuma) para não cair no limite de 60 consultas por hora
GITHUB_TOKEN=
