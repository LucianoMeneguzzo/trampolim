# Copie este arquivo para "backend/.env" e preencha com os valores reais.
# O .env é ignorado pelo git: nunca commite senha de banco ou chave do JWT.
# Sem o .env o backend sobe com banco em memória (H2): serve para testar, mas os dados somem ao parar.

DB_URL=jdbc:postgresql://SEU-HOST.supabase.co:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=troque-pela-senha-do-banco

# Qualquer texto longo e aleatório com 32+ caracteres
JWT_SECRET=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
JWT_EXPIRATION=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173
