# Usado só pelo Docker (docker-compose.yml). Copie para ".env" nesta pasta e preencha.
# O .env é ignorado pelo git: senha nunca vai para o GitHub.
#
# Gere cada valor no Git Bash com:  openssl rand -hex 32

# Senha do banco PostgreSQL que sobe dentro do Docker
POSTGRES_PASSWORD=

# Chave que assina os tokens de login (mínimo de 32 caracteres)
JWT_SECRET=

# Opcional: token do GitHub (sem permissão nenhuma) para não cair no limite de 60 consultas por hora
GITHUB_TOKEN=

# Opcional: servidor de e-mail (SMTP) dos avisos. Sem MAIL_HOST, os avisos só aparecem no log do back
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
